pipeline {
    agent none

    stages {

        stage('Node.js Build') {
            agent { label 'node-agent' }
            steps {
                dir('node-app') {
                    // This runs the app in the background so Jenkins doesn't hang
                    sh 'nohup node app.js > output.log 2>&1 &'
                }
            }
        }
/*
        stage('Python Build') {
            agent { label 'python-agent' }
            steps {
                dir('python-app') {
                    sh 'python3 app.py'
                }
            }
        }

        stage('Java Build') {
            agent { label 'java-agent' }
            steps {
                dir('java-app') {
                    sh 'mvn clean package || true'
                }
            }
        }
           */
    }
}

